// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  // distinct url for migrations, which cannot use pooled connection
  // https://supabase.com/partners/integrations/prisma
  directUrl = env("POSTGRES_PRISMA_URL")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  DECLINED
  INACTIVE
}

model User {
  id          Int              @id @default(autoincrement())
  firstName   String
  lastName    String
  description String
  memberships UserMembership[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Club {
  id                  Int              @id @default(autoincrement())
  publicId            String           @unique
  name                String
  tagLine             String
  description         String
  websiteUrl          String?
  eventCalendarUrl    String?
  instagramHandle     String?
  onboardingQuestions Json
  membershipTiers     MembershipTier[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model MembershipTier {
  id                Int              @id @default(autoincrement())
  name              String
  description       String
  costPerMonthInUSD Decimal
  club              Club             @relation(fields: [clubId], references: [id])
  clubId            Int
  memberships       UserMembership[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model UserMembership {
  id               BigInt           @id @default(autoincrement())
  userId           Int
  user             User             @relation(fields: [userId], references: [id])
  membershipTierId Int
  membershipTier   MembershipTier   @relation(fields: [membershipTierId], references: [id])
  status           MembershipStatus
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
