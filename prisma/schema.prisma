// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  // distinct url for migrations, which cannot use pooled connection
  // https://supabase.com/partners/integrations/prisma
  directUrl = env("POSTGRES_PRISMA_URL")
}

enum MembershipStatus {
  ACTIVE
  // e.g., awaiting setup intent
  PENDING_INCOMPLETE
  PENDING
  DECLINED
  WITHDRAWN
  INACTIVE
}

enum MembershipTierStatus {
  PUBLISHED
  UNPUBLISHED
}

enum EmailTemplateType {
  ACCEPTANCE
  REJECTION
  DEPARTURE
}

enum EmailBlastStatus {
  DRAFT
  SENT
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
}

enum Role {
  // this role also includes club management permissions
  LEAD
  MEMBER
}

model User {
  id          Int             @id @default(autoincrement())
  // internal-only
  authUserId  String          @unique @map("auth_user_id") @db.Uuid
  firstName   String          @map("first_name")
  lastName    String          @map("last_name")
  description String
  settings    UserSettings?
  socials     UserSocials?
  memberships Membership[]
  following   ClubFollowing[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // for rls look-ups
  @@index([authUserId])
  @@map("user")
}

model UserSettings {
  userId    Int      @id @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  email     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

model UserSocials {
  userId    Int      @id @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  twitter   String?
  instagram String?
  facebook  String?
  linkedin  String?
  website   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_socials")
}

model Club {
  id                                  Int              @id @default(autoincrement())
  publicId                            String           @unique @map("public_id")
  name                                String
  tagLine                             String           @map("tag_line")
  description                         String
  startDate                           DateTime?        @map("start_date")
  startTime                           String?          @map("start_time")
  frequency                           String?          @map("frequency")
  // TODO make this non-nullable after all values have been backpopulated
  // city and state (e.g., San Francisco, CA)
  location                            String?
  websiteUrl                          String?          @map("website_url")
  eventCalendarUrl                    String?          @map("event_calendar_url")
  instagramHandle                     String?          @map("instagram_handle")
  applicationQuestions                Json             @map("application_questions")
  theme                               Json?
  themeHeadingFont                    String?          @map("theme_heading_font")
  // ordered
  displayImageUrls                    String[]         @default([]) @map("display_image_urls")
  faqs                                Json             @map("faqs")
  membershipTiers                     MembershipTier[]
  following                           ClubFollowing[]
  emailTemplates                      EmailTemplate[]
  emailBlasts                         EmailBlast[]
  stripeConnectAccountId              String?          @unique @map("stripe_connect_account_id")
  stripeCustomerPortalConfigurationId String?          @unique @map("stripe_customer_portal_configuration_id")
  createdAt                           DateTime         @default(now()) @map("created_at")
  updatedAt                           DateTime         @updatedAt @map("updated_at")

  @@index([publicId])
  @@map("club")
}

model MembershipTier {
  id                         Int                  @id @default(autoincrement())
  name                       String
  benefitDescription         String               @map("benefit_description")
  contributionDescription    String               @map("contribution_description")
  costPerBillingInterval     Decimal              @map("cost_per_billing_interval")
  billingInterval            BillingInterval      @map("billing_interval")
  initiationFeeCostInUSD     Decimal?             @map("initiation_fee_cost_in_usd")
  club                       Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId                     Int                  @map("club_id")
  status                     MembershipTierStatus @default(PUBLISHED)
  stripeProductId            String?              @unique @map("stripe_product_id")
  // active prices
  stripePriceId              String?              @unique @map("stripe_price_id")
  initiationFeeStripePriceId String?              @unique @map("initiation_fee_stripe_price_id")
  memberships                Membership[]
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  @@index([clubId])
  @@map("membership_tier")
}

model Membership {
  id                   BigInt           @id @default(autoincrement())
  userId               Int              @map("user_id")
  user                 User             @relation(fields: [userId], references: [id])
  role                 Role             @default(MEMBER)
  membershipTierId     Int              @map("membership_tier_id")
  membershipTier       MembershipTier   @relation(fields: [membershipTierId], references: [id], onDelete: Cascade)
  applicationResponses Json             @map("application_responses")
  status               MembershipStatus
  isWelcomed           Boolean          @default(false) @map("is_welcomed")
  stripeCustomerId     String?          @unique @map("stripe_customer_id")
  stripeSetupIntentId  String?          @unique @map("stripe_setup_intent_id")
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@unique([userId, membershipTierId])
  @@index([userId])
  @@index([membershipTierId])
  @@map("membership")
}

model ClubFollowing {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  clubId    Int      @map("club_id")
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
  @@map("club_following")
}

model EmailTemplate {
  clubId      Int               @map("club_id")
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  type        EmailTemplateType
  subject     String
  htmlContent String            @map("html_content") @db.Text
  textContent String            @map("text_content") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@id([clubId, type])
  @@map("email_template")
}

model EmailBlast {
  id          BigInt           @id @default(autoincrement())
  clubId      Int              @map("club_id")
  club        Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  subject     String
  htmlContent String           @map("html_content") @db.Text
  textContent String           @map("text_content") @db.Text
  status      EmailBlastStatus @default(DRAFT)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([clubId])
  @@index([clubId, status])
  @@map("email_blast")
}

// !! PROTOTYPE
model ReferralEmail {
  id         BigInt   @id @default(autoincrement())
  referrerId Int      @map("referrer_id")
  email      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([referrerId])
  @@map("referral_email")
}
