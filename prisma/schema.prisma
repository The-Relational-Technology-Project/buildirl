// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  // distinct url for migrations, which cannot use pooled connection
  // https://supabase.com/partners/integrations/prisma
  directUrl = env("POSTGRES_PRISMA_URL")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  DECLINED
  INACTIVE
}

enum MembershipTierStatus {
  PUBLISHED
  UNPUBLISHED
}

model User {
  id          Int           @id @default(autoincrement())
  // internal-only
  authUserId  String        @unique @map("auth_user_id")
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  description String
  settings    UserSettings?
  memberships Membership[]
  club        Club[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("user")
}

model UserSettings {
  userId    Int      @id @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

model Club {
  id                   Int              @id @default(autoincrement())
  publicId             String           @unique @map("public_id")
  name                 String
  tagLine              String           @map("tag_line")
  description          String
  owner                User             @relation(fields: [ownerUserId], references: [id])
  ownerUserId          Int              @map("owner_user_id")
  websiteUrl           String?          @map("website_url")
  eventCalendarUrl     String?          @map("event_calendar_url")
  instagramHandle      String?          @map("instagram_handle")
  applicationQuestions Json             @map("application_questions")
  theme                Json?
  // ordered
  displayImageUrls     String[]         @default([]) @map("display_image_urls")
  membershipTiers      MembershipTier[]
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@map("club")
}

model MembershipTier {
  id                      Int                  @id @default(autoincrement())
  name                    String
  benefitDescription      String               @map("benefit_description")
  contributionDescription String               @map("contribution_description")
  costPerMonthInUSD       Decimal              @map("cost_per_month_usd")
  club                    Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId                  Int                  @map("club_id")
  status                  MembershipTierStatus @default(PUBLISHED)
  memberships             Membership[]
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  @@map("membership_tier")
}

model Membership {
  id                   BigInt           @id @default(autoincrement())
  userId               Int              @map("user_id")
  user                 User             @relation(fields: [userId], references: [id])
  membershipTierId     Int              @map("membership_tier_id")
  membershipTier       MembershipTier   @relation(fields: [membershipTierId], references: [id], onDelete: Cascade)
  applicationResponses Json             @map("application_responses")
  status               MembershipStatus
  isWelcomed           Boolean          @default(false) @map("is_welcomed")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@unique([userId, membershipTierId])
  @@map("membership")
}
