// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  // distinct url for migrations, which cannot use pooled connection
  // https://supabase.com/partners/integrations/prisma
  directUrl = env("POSTGRES_PRISMA_URL")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  DECLINED
  INACTIVE
}

model User {
  id          Int          @id @default(autoincrement())
  // internal-only
  authUserId  String       @unique
  firstName   String
  lastName    String
  description String
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Club        Club[]

  @@map("user")
}

model Club {
  id                   Int              @id @default(autoincrement())
  publicId             String           @unique
  name                 String
  tagLine              String
  description          String
  owner                User             @relation(fields: [ownerUserId], references: [id])
  ownerUserId          Int
  websiteURL           String?
  eventCalendarURL     String?
  instagramHandle      String?
  applicationQuestions Json
  membershipTiers      MembershipTier[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("club")
}

model MembershipTier {
  id                      Int          @id @default(autoincrement())
  name                    String
  benefitDescription      String
  contributionDescription String
  costPerMonthInUSD       Decimal
  club                    Club         @relation(fields: [clubId], references: [id])
  clubId                  Int
  memberships             Membership[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("membership_tier")
}

model Membership {
  id                   BigInt           @id @default(autoincrement())
  userId               Int
  user                 User             @relation(fields: [userId], references: [id])
  membershipTierId     Int
  membershipTier       MembershipTier   @relation(fields: [membershipTierId], references: [id])
  applicationResponses Json
  status               MembershipStatus
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([userId, membershipTierId])
  @@map("membership")
}
