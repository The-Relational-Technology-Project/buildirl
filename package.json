{
  "name": "buildirl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "test": "jest",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "yarn prettier --write .",
    "format-check": "yarn prettier --check . && yarn unused-exports",
    "unused-exports": "ts-unused-exports tsconfig.json --excludePathsFromReport=test",
    "verify": "yarn typecheck && yarn test test/e2e/system.test.ts",
    "format-verify": "yarn format-check && yarn verify"
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@hookform/resolvers": "^3.10.0",
    "@mantine/carousel": "^7.16.2",
